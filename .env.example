# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For scripts (check-and-migrate.ts, etc.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Direct Postgres connection for db-sync (runs before every build; applies
# pending migrations + seed). Get it from Supabase: Project Settings -> Database.
# If unset, the build skips the db check with a warning.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
